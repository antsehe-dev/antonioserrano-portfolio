---
import { t } from '../../i18n/index';
import { timeline } from '../../data/experience';

interface Props { lang: string; }
const { lang } = Astro.props;
const tr = t(lang);

const titleWords = tr.about.title.split(' ');
const bodyWords = tr.about.body.split(' ');
---

<section id="about" class="px-6 max-w-5xl mx-auto">
  <!-- Section rule -->
  <div class="flex items-center gap-4 mb-16">
    <span class="font-mono text-xs tracking-widest" style="color:var(--color-accent);">01</span>
    <div class="flex-1" style="height:1px;background:linear-gradient(90deg,rgba(139,159,255,0.4),var(--color-border));"></div>
    <span class="font-mono text-xs tracking-widest uppercase" style="color:var(--color-dim);">{lang === 'en' ? 'About' : 'Sobre mí'}</span>
  </div>

  <!-- Two-column: heading+bio | stats -->
  <div class="grid md:grid-cols-[1fr_220px] gap-12 mb-24">
    <div>
      <h2 class="about-title text-4xl md:text-7xl font-black mb-8" style="letter-spacing:-0.04em;color:var(--color-heading);text-shadow:0 0 80px rgba(139,159,255,0.3);" aria-label={tr.about.title}>
        {titleWords.map((word, wi, arr) => [
          <span style="display:inline-block;white-space:nowrap;">
            {word.split('').map((ch) => (
              <span class="about-char" style="display:inline-block;overflow:hidden;">
                <span class="about-char-inner" style="display:inline-block;">{ch}</span>
              </span>
            ))}
          </span>,
          wi < arr.length - 1 ? ' ' : ''
        ])}
      </h2>

      <p class="text-base md:text-lg leading-relaxed max-w-2xl" style="color:var(--color-dim);" aria-label={tr.about.body}>
        {bodyWords.map((word, i) => (
          <span class="about-word" style="opacity:0;display:inline;">{word}{i < bodyWords.length - 1 ? ' ' : ''}</span>
        ))}
      </p>
    </div>

    <!-- Stats sidebar -->
    <aside class="flex flex-col gap-6 md:pt-2 about-exp-title" style="opacity:0;">
      <div>
        <p class="font-mono text-xs uppercase tracking-widest mb-1" style="color:var(--color-faint);">{lang === 'en' ? 'base' : 'base'}</p>
        <p class="text-sm" style="color:var(--color-muted);">Córdoba, España</p>
      </div>
      <div>
        <p class="font-mono text-xs uppercase tracking-widest mb-1" style="color:var(--color-faint);">{lang === 'en' ? 'role' : 'rol'}</p>
        <p class="text-sm" style="color:var(--color-muted);">AI Engineer</p>
      </div>
      <div>
        <p class="font-mono text-xs uppercase tracking-widest mb-1" style="color:var(--color-faint);">{lang === 'en' ? 'company' : 'empresa'}</p>
        <p class="text-sm" style="color:var(--color-muted);">Softtek Innovation Labs</p>
      </div>
      <div class="pt-2">
        <span class="text-2xl font-black" style="color:var(--color-accent);letter-spacing:-0.04em;">~6m</span>
        <p class="font-mono text-xs mt-0.5" style="color:var(--color-faint);">{lang === 'en' ? 'experience' : 'experiencia'}</p>
      </div>
    </aside>
  </div>

  <!-- Experience divider -->
  <div class="flex items-center gap-4 mb-10 about-exp-divider" style="opacity:0;">
    <div class="flex-1" style="height:1px;background:var(--color-border);"></div>
    <span class="font-mono text-xs uppercase tracking-widest" style="color:var(--color-faint);">{tr.about.experience_title}</span>
    <div class="flex-1" style="height:1px;background:var(--color-border);"></div>
  </div>

  <!-- Timeline -->
  <div class="relative pl-6 flex flex-col gap-10">
    <!-- Vertical line -->
    <div class="absolute left-0 top-0 bottom-0 w-px" style="background:var(--color-border);overflow:hidden;">
      <div id="timeline-line" style="width:100%;height:0%;background:var(--color-accent);opacity:0.5;"></div>
    </div>

    {timeline.map((item, i) => (
      <div class="timeline-item relative" data-index={i} style="opacity:0;">
        <!-- Dot -->
        <span
          class="absolute -left-7 top-[0.6rem] w-2 h-2 rounded-full"
          style="background:var(--color-bg);border:1.5px solid var(--color-accent);box-shadow:0 0 8px rgba(139,159,255,0.45);"
          aria-hidden="true"
        ></span>

        <div>
          <div class="flex items-center gap-3 mb-1">
            <span class="font-mono text-xs" style="color:var(--color-dim);">
              {item.type === 'work' ? (lang === 'en' ? 'work' : 'trabajo') : (lang === 'en' ? 'education' : 'formación')}
            </span>
            <span class="font-mono text-xs" style="color:var(--color-dim);">
              {lang === 'en' ? item.period_en : item.period}
            </span>
          </div>
          <h4 class="text-base md:text-lg font-bold mb-0.5">
            {lang === 'en' ? item.title_en : item.title}
          </h4>
          <p class="text-sm font-mono mb-2" style="color:#8b9fff;">{item.org}</p>
          <p class="text-sm leading-relaxed" style="color:var(--color-dim);">
            {lang === 'en' ? item.description_en : item.description}
          </p>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduced) {
    gsap.from('.about-char-inner', {
      y: '110%',
      stagger: 0.025,
      duration: 0.55,
      ease: 'power3.out',
      scrollTrigger: { trigger: '.about-title', start: 'top 85%' },
    });

    gsap.to('.about-word', {
      opacity: 1,
      stagger: 0.02,
      duration: 0.3,
      ease: 'power2.out',
      scrollTrigger: { trigger: '.about-word', start: 'top 85%' },
    });

    gsap.to('.about-exp-title', {
      opacity: 1,
      duration: 0.5,
      ease: 'power2.out',
      scrollTrigger: { trigger: '.about-exp-title', start: 'top 88%' },
    });

    gsap.to('.about-exp-divider', {
      opacity: 1,
      duration: 0.5,
      ease: 'power2.out',
      scrollTrigger: { trigger: '.about-exp-divider', start: 'top 88%' },
    });

    const items = gsap.utils.toArray<HTMLElement>('.timeline-item');
    if (items.length > 0) {
      ScrollTrigger.create({
        trigger: items[0],
        endTrigger: items[items.length - 1],
        start: 'top 80%',
        end: 'bottom 60%',
        scrub: 1,
        onUpdate: (self) => {
          const line = document.getElementById('timeline-line');
          if (line) line.style.height = self.progress * 100 + '%';
        },
      });
    }

    gsap.utils.toArray<HTMLElement>('.timeline-item').forEach((el, i) => {
      gsap.fromTo(el,
        { opacity: 0, y: 20 },
        {
          opacity: 1, y: 0, duration: 0.5,
          delay: i * 0.08,
          ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 88%' },
        }
      );
    });
  } else {
    document.querySelectorAll<HTMLElement>('.about-word, .about-exp-title, .about-exp-divider, .timeline-item').forEach((el) => {
      el.style.opacity = '1';
      el.style.transform = 'none';
    });
    const line = document.getElementById('timeline-line');
    if (line) line.style.height = '100%';
  }
</script>
