---
import { t } from '../../i18n/index';
interface Props { lang: string; }
const { lang } = Astro.props;
const tr = t(lang);
---

<footer class="py-8 px-6 text-center text-sm text-[var(--color-muted)]" style="border-top:1px solid rgba(123,97,255,0.18);">
  <p>{tr.footer.built}</p>
  <p class="mt-1 opacity-60">© {new Date().getFullYear()} Antonio Serrano Herruzo</p>
</footer>
